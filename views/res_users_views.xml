<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extensión de la vista Formulario de Usuarios (res.users) -->
    <record id="view_users_form_app_restriction" model="ir.ui.view">
        <field name="name">res.users.form.app.restriction</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Visibilidad de Apps" name="app_visibility_page" groups="base.group_erp_manager,base.group_system">
                    <group string="Control de Visibilidad en Menú Principal (Waffle Menu)">
                        <p class="text-muted" colspan="2">
                            Todas las aplicaciones instaladas aparecen aquí tildadas por defecto (las apps nuevas que se instalen a futuro aparecen solas, sin tocar código). Desmarque únicamente aquellas que desea ocultar del menú principal de este usuario.
                        </p>
                    </group>
                    <div class="mb-3">
                        <button name="action_enable_all_apps" type="object" string="Habilitar Todas" class="btn btn-secondary me-2" icon="fa-check-square-o"/>
                        <button name="action_disable_all_apps" type="object" string="Desmarcar Todas" class="btn btn-secondary" icon="fa-square-o"/>
                    </div>
                    <field name="visible_app_ids" widget="many2many_checkboxes" nolabel="1"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
